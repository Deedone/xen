/dts-v1/;

/*
 * Xen overlay for the Ironhide (R8A78000) board.
 *
 * Includes the plain board DTS and layers the Xen-specific wiring on top:
 * SMMU stream enablement, IOMMU bindings and xen,passthrough markers.
 *
 * /chosen is left as a bare node (stdout-path only). The dom0 / domU / xsm-policy
 * multiboot modules and the Xen command line are injected at boot time by the
 * test runner (gen5-xtf.sh / gen5-zephyr.sh) with fdt commands, because the load
 * addresses and payloads differ per test. The BSP's baked Linux-dom0 modules
 * (dom0@0x64000000, xsm@0x53000000) are intentionally dropped here.
 */

/include/ "r8a78000-ironhide.dts"

/ {
    chosen {
        stdout-path = "serial0:1843200n8";
    };
};

&smmu_hcn {
    status = "okay";
};

&smmu_pere {
    status = "okay";
};

&smmu_pv {
    status = "okay";
};

&smmu_hcs1 {
    status = "okay";
};

&smmu_mp {
    status = "okay";
};

&smmu_perw {
    status = "disabled";
};

&smmu_dsp {
    status = "disabled";
};

&smmu_hcs0 {
    status = "disabled";
};

&smmu_imn {
    status = "disabled";
};

&smmu_ims {
    status = "disabled";
};

&smmu_npu0 {
    status = "disabled";
};

&smmu_npu1 {
    status = "disabled";
};

&smmu_rt {
    status = "disabled";
};

&smmu_scp {
    status = "disabled";
};

&smmu_vipn {
    status = "disabled";
};

&smmu_vips {
    status = "disabled";
};

&smmu_vi0 {
    status = "disabled";
};

&smmu_vi1 {
    status = "disabled";
};

&rswitch3 {
    iommus = <&smmu_hcn 0x0>, <&smmu_hcn 0x1>,
             <&smmu_hcn 0x2>, <&smmu_hcn 0x3>,
             <&smmu_hcn 0x4>, <&smmu_hcn 0x5>,
             <&smmu_hcn 0x6>, <&smmu_hcn 0x7>,
             <&smmu_hcn 0x10000>, <&smmu_hcn 0x10001>,
             <&smmu_hcn 0x10002>, <&smmu_hcn 0x10003>,
             <&smmu_hcn 0x10004>, <&smmu_hcn 0x10005>,
             <&smmu_hcn 0x10006>, <&smmu_hcn 0x10007>,
             <&smmu_hcn 0x20000>, <&smmu_hcn 0x30000>,
             <&smmu_hcn 0x40000>, <&smmu_hcn 0x50000>,
             <&smmu_hcn 0x60000>, <&smmu_hcn 0x70000>,
             <&smmu_hcn 0x80000>, <&smmu_hcn 0x90000>;
};

&mmc0 {
    iommus = <&smmu_pere 0x20000>;
};

&ufs0 {
    iommus = <&smmu_pere 0x30000>;
};

&ufs1 {
    iommus = <&smmu_pere 0x40000>;
};

/ {
    soc {
        gsx_osid0_domd: gsx_osid0_domd {
            iommus = <&smmu_pv 0x00>, <&smmu_pv 0x10000>, <&smmu_pv 0x20000>, <&smmu_pv 0x30000>;
            xen,passthrough;
        };

        gsx_osid1: gsx_osid1 {
            iommus = <&smmu_pv 0x01>, <&smmu_pv 0x10001>, <&smmu_pv 0x20001>, <&smmu_pv 0x30001>;
            xen,passthrough;
        };
    };
};

&usb30 {
    iommus = <&smmu_hcn 0xc0000>;
};

&usb31 {
    iommus = <&smmu_hcn 0xd0000>;
};

&usb20 {
    iommus = <&smmu_hcn 0xe0000>;
};

&usb21 {
    iommus = <&smmu_hcn 0xf0000>;
};

&pciec60 {
    iommus = <&smmu_hcs1 0x20000>;
    iommu-map = <0x0 &smmu_hcs1 0x20000 0x10000>;

    linux,pci-domain = <1>;
};

&audio_dmac0 {
    iommus = <&smmu_mp 0x40000>, <&smmu_mp 0x40001>,
             <&smmu_mp 0x40002>, <&smmu_mp 0x40003>,
             <&smmu_mp 0x40004>, <&smmu_mp 0x40005>,
             <&smmu_mp 0x40006>, <&smmu_mp 0x40007>,
             <&smmu_mp 0x40008>, <&smmu_mp 0x40009>,
             <&smmu_mp 0x4000a>, <&smmu_mp 0x4000b>,
             <&smmu_mp 0x4000c>, <&smmu_mp 0x4000d>,
             <&smmu_mp 0x4000e>, <&smmu_mp 0x4000f>;
};

&audio_dmac1 {
    iommus = <&smmu_mp 0x50000>, <&smmu_mp 0x50001>,
             <&smmu_mp 0x50002>, <&smmu_mp 0x50003>,
             <&smmu_mp 0x50004>, <&smmu_mp 0x50005>,
             <&smmu_mp 0x50006>, <&smmu_mp 0x50007>,
             <&smmu_mp 0x50008>, <&smmu_mp 0x50009>,
             <&smmu_mp 0x5000a>, <&smmu_mp 0x5000b>,
             <&smmu_mp 0x5000c>, <&smmu_mp 0x5000d>,
             <&smmu_mp 0x5000e>, <&smmu_mp 0x5000f>;
};

&extal_clk {
    xen,passthrough;
};

&extalr_clk {
    xen,passthrough;
};

/ {
    firmware {
        xen,passthrough;
    };

    soc {
        mfis_lock@189e0000 {
            xen,passthrough;
        };
    };
};

