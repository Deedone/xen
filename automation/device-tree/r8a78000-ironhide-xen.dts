/ {
    reserved-memory {
        vdev_regions-domd {
            reg = <0x0 0xa0000000 0x0 0x1000000>;
            no-map;
        };

        vdev_region-domu {
            reg = <0x0 0xa1000000 0x0 0x1000000>;
            no-map;
        };

        rvgc_region-domu {
            reg = <0x0 0xa2000000 0x0 0x10000000>;
            no-map;
        };

        rvgc_region-domd {
            reg = <0x0 0xb2000000 0x0 0xe000000>;
            no-map;
        };

        pcires@50000000 {
            no-map;
            reg = <0x00 0x50000000 0x00 0x1000>;
        };
    };
};

&cr52_rproc2 {
    xen,passthrough;
};

&mfis_ch2 {
    xen,passthrough;
};
