 };

 canfd12_pins: canfd12 {
  groups = "canfd12_data_b";
  function = "canfd12";
 };

 canfd13_pins: canfd13 {
  groups = "canfd13_data_b";
  function = "canfd13";
 };

 canfd14_pins: canfd14 {
  groups = "canfd14_data_b";
  function = "canfd14";
 };

 canfd15_pins: canfd15 {
  groups = "canfd15_data_b";
  function = "canfd15";
 };

 sound_pins: sound {
  groups = "ssi5_ctrl", "ssi5_data";
  function = "ssi5";
 };

 sound_clk_pins: sound_clk {
  groups = "audio_clk_a_a", "audio0_clkout0";
  function = "audio_clk";
 };
};

&rpc {
 pinctrl-0 = <&rpc_pins>;
 pinctrl-names = "default";

 status = "okay";

 flash@0 {
  compatible = "cypress,hyperflash", "cfi-flash";
  reg = <0>;
  spi-max-frequency = <160000000>;
  spi-rx-bus-width = <4>;
  spi-tx-bus-width = <1>;

  partitions {
   compatible = "fixed-partitions";
   #address-cells = <1>;
   #size-cells = <1>;

   boot@0 {
    reg = <0x0 0x1200000>;
    read-only;
   };

   user@2780000 {
    reg = <0x2780000 0x01880000>;
   };
  };
 };
};

&pciec40 {
 status = "okay";
 phys = <&mp_phy 0 1>;
};

&pciec60 {
 status = "okay";
};

&pciec60_ep {
 status = "disabled";
};

&pciec61 {
 status = "disabled";
};

&pciec61_ep {
