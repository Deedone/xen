 timer {
  compatible = "arm,armv8-timer";
  interrupts-extended = <&gic 1 13 8>,
          <&gic 1 14 8>,
          <&gic 1 11 8>,
          <&gic 1 10 8>,
          <&gic 1 12 8>;
  interrupt-names = "sec-phys", "phys", "virt", "hyp-phys",
      "hyp-virt";
 };

 ufs0_clk: ufs0-clk {
  compatible = "fixed-clock";
  #clock-cells = <0>;

  clock-frequency = <0>;
 };

 ufs1_clk: ufs1-clk {
  compatible = "fixed-clock";
  #clock-cells = <0>;

  clock-frequency = <0>;
 };
};
/ {
 compatible = "renesas,r8a78000";
 #address-cells = <2>;
 #size-cells = <2>;

 audio_clk_a: audio_clk_a {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 audio_clk_b: audio_clk_b {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 audio_clk_c: audio_clk_c {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 dummy_clk: dummy_clk {
  compatible = "fixed-clock";
  clock-frequency = <0>;
  #clock-cells = <0>;
 };

 can_clk: can {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 canxl_clk: canxl_clk {
  compatible = "fixed-clock";
  clock-frequency = <160000000>;
  #clock-cells = <0>;
 };

 ssi_dummy_clk: ssi_dummy_clk {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
  clock-output-names = "ssi";
 };

 scu_dummy_clk: scu_dummy_clk {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
  clock-output-names = "scu";
 };

