  rcar_sound: sound@ec500000 {
   compatible = "renesas,rcar_sound-r8a78000", "renesas,rcar_sound-gen5";
   reg = <0 0xec500000 0 0x21004>,
    <0 0xec530000 0 0x140>,
    <0 0xec540000 0 0x9a004>,
    <0 0xec740000 0 0x1c030>;
   reg-names = "scu", "adg", "ssiu", "audmapp";

   clocks = <&scmi_clk 250>, <&scmi_clk 252>,
     <&scmi_clk 262>, <&scmi_clk 261>,
     <&scmi_clk 260>, <&scmi_clk 259>,
     <&scmi_clk 258>, <&scmi_clk 257>,
     <&scmi_clk 256>, <&scmi_clk 255>,
     <&scmi_clk 254>, <&scmi_clk 253>,
     <&scmi_clk 274>,
     <&scmi_clk 284>, <&scmi_clk 283>,
     <&scmi_clk 282>, <&scmi_clk 281>,
     <&scmi_clk 280>, <&scmi_clk 279>,
     <&scmi_clk 278>, <&scmi_clk 277>,
     <&scmi_clk 276>, <&scmi_clk 275>,
     <&scmi_clk 286>, <&scmi_clk 285>,
     <&scmi_clk 286>, <&scmi_clk 285>,
     <&scmi_clk 287>, <&scmi_clk 288>,
     <&scmi_clk 304>, <&scmi_clk 305>,
     <&audio_clk_a>, <&audio_clk_b>,
     <&audio_clk_c>;
   clock-names = "adg", "ssi-all",
          "ssi.9", "ssi.8", "ssi.7", "ssi.6",
          "ssi.5", "ssi.4", "ssi.3", "ssi.2",
          "ssi.1", "ssi.0",
          "scu-all",
          "src.9", "src.8", "src.7", "src.6",
          "src.5", "src.4", "src.3", "src.2",
          "src.1", "src.0",
          "mix.1", "mix.0",
          "ctu.1", "ctu.0",
          "dvc.0", "dvc.1",
          "dmapp.0", "dmapp.1",
          "clk_a", "clk_b", "clk_c";
   status = "disabled";

   rcar_sound,dvc {
    dvc0: dvc-0 {
     dmas = <&audio_dmac1 0x94>;
     dma-names = "tx";
    };
    dvc1: dvc-1 {
     dmas = <&audio_dmac1 0x92>;
     dma-names = "tx";
    };
   };

   rcar_sound,mix {
    mix0: mix-0 { };
    mix1: mix-1 { };
   };

   rcar_sound,ctu {
    ctu00: ctu-0 { };
    ctu01: ctu-1 { };
    ctu02: ctu-2 { };
    ctu03: ctu-3 { };
    ctu10: ctu-4 { };
    ctu11: ctu-5 { };
    ctu12: ctu-6 { };
    ctu13: ctu-7 { };
   };

   rcar_sound,src {
    src0: src-0 {
     interrupts = <0 916 4>;
     dmas = <&audio_dmac0 0x13>, <&audio_dmac1 0x14>;
     dma-names = "rx", "tx";
    };
    src1: src-1 {
     interrupts = <0 917 4>;
     dmas = <&audio_dmac0 0x11>, <&audio_dmac1 0x12>;
     dma-names = "rx", "tx";
    };
    src2: src-2 {
     interrupts = <0 918 4>;
     dmas = <&audio_dmac0 0x0F>, <&audio_dmac1 0x10>;
     dma-names = "rx", "tx";
    };
    src3: src-3 {
     interrupts = <0 919 4>;
     dmas = <&audio_dmac0 0x0D>, <&audio_dmac1 0x0E>;
     dma-names = "rx", "tx";
    };
    src4: src-4 {
     interrupts = <0 920 4>;
     dmas = <&audio_dmac0 0x0B>, <&audio_dmac1 0x0C>;
     dma-names = "rx", "tx";
    };
    src5: src-5 {
     interrupts = <0 921 4>;
     dmas = <&audio_dmac0 0x09>, <&audio_dmac1 0x0A>;
     dma-names = "rx", "tx";
    };
    src6: src-6 {
     interrupts = <0 922 4>;
     dmas = <&audio_dmac0 0x07>, <&audio_dmac1 0x08>;
     dma-names = "rx", "tx";
    };
    src7: src-7 {
     interrupts = <0 923 4>;
     dmas = <&audio_dmac0 0x05>, <&audio_dmac1 0x06>;
     dma-names = "rx", "tx";
