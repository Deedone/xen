    };
   };

   cluster5 {
    core0 {
     cpu = <&a720_20>;
    };
    core1 {
     cpu = <&a720_21>;
    };
    core2 {
     cpu = <&a720_22>;
    };
    core3 {
     cpu = <&a720_23>;
    };
   };

   cluster6 {
    core0 {
     cpu = <&a720_24>;
    };
    core1 {
     cpu = <&a720_25>;
    };
    core2 {
     cpu = <&a720_26>;
    };
    core3 {
     cpu = <&a720_27>;
    };
   };

   cluster7 {
