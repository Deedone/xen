   renesas,#read_outstanding = <2>;
   renesas,#start_reservation = <2>;
   power-domains = <&scmi_devpd 11>;
   resets = <&scmi_reset 171>,
     <&scmi_reset 180>;
   reset-names = "vsp", "fcp";
   status = "disabled";
  };

  vspb0: vspm@c50c0000 {
   compatible = "renesas,vspm";
   reg = <0 0xc50c0000 0 0x8000>, <0 0xc5038000 0 0x200>;
   interrupts = <0 618 4>;
   clocks = <&scmi_clk 163>,
     <&scmi_clk 172>;
   clock-names = "vsp", "fcp";
   renesas,#ch = <4>;
   renesas,#rpf = <31>;
   renesas,#rpf_clut = <6>;
   renesas,#wpf_rot = <0>;
   renesas,has-bru;
   renesas,#read_outstanding = <0>;
   renesas,#start_reservation = <2>;
   renesas,#burst_access = <0>;
   power-domains = <&scmi_devpd 11>;
   resets = <&scmi_reset 163>,
     <&scmi_reset 172>;
   reset-names = "vsp", "fcp";
   status = "disabled";
  };

