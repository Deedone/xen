    };
   };

   port@4 {
    reg = <4>;
    max96726_out1: endpoint {
     bus-type = <1>;
     clock-lanes = <0>;
     data-lanes = <1 2 3 4>;
     remote-endpoint = <&csi41_in>;
    };
   };
  };

  i2c-mux {
   #address-cells = <1>;
   #size-cells = <0>;

   i2c@0 {
    #address-cells = <1>;
    #size-cells = <0>;
    reg = <0>;

    status = "disabled";
   };

   i2c@1 {
    #address-cells = <1>;
