/dts-v1/;

/ {
 compatible = "renesas,r8a78000";
 #address-cells = <2>;
 #size-cells = <2>;

 audio_clk_a: audio_clk_a {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 audio_clk_b: audio_clk_b {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 audio_clk_c: audio_clk_c {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 dummy_clk: dummy_clk {
  compatible = "fixed-clock";
  clock-frequency = <0>;
  #clock-cells = <0>;
 };

 can_clk: can {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 canxl_clk: canxl_clk {
  compatible = "fixed-clock";
  clock-frequency = <160000000>;
  #clock-cells = <0>;
 };

 ssi_dummy_clk: ssi_dummy_clk {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
  clock-output-names = "ssi";
 };

 scu_dummy_clk: scu_dummy_clk {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
  clock-output-names = "scu";
 };

 cpus {
  #address-cells = <2>;
  #size-cells = <0>;

  cpu-map {
   cluster0 {
    core0 {
     cpu = <&a720_0>;
    };
    core1 {
     cpu = <&a720_1>;
    };
    core2 {
     cpu = <&a720_2>;
    };
    core3 {
     cpu = <&a720_3>;
    };
   };

   cluster1 {
    core0 {
     cpu = <&a720_4>;
    };
    core1 {
     cpu = <&a720_5>;
    };
    core2 {
     cpu = <&a720_6>;
    };
    core3 {
     cpu = <&a720_7>;
    };
   };

   cluster2 {
    core0 {
     cpu = <&a720_8>;
    };
    core1 {
     cpu = <&a720_9>;
    };
    core2 {
     cpu = <&a720_10>;
    };
    core3 {
     cpu = <&a720_11>;
    };
   };

   cluster3 {
    core0 {
     cpu = <&a720_12>;
    };
    core1 {
     cpu = <&a720_13>;
    };
    core2 {
     cpu = <&a720_14>;
    };
    core3 {
     cpu = <&a720_15>;
    };
   };

   cluster4 {
    core0 {
     cpu = <&a720_16>;
    };
    core1 {
     cpu = <&a720_17>;
    };
    core2 {
     cpu = <&a720_18>;
    };
    core3 {
