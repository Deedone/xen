   interrupt-map-mask = <0 0 0 7>;
   interrupt-map = <0 0 0 1 &gic 0 758 4
      0 0 0 2 &gic 0 758 4
      0 0 0 3 &gic 0 758 4
      0 0 0 4 &gic 0 758 4>;
   clocks = <&pcie6_bus_clk>;
   clock-names = "pcie6_bus";
   max-link-speed = <1>;
   num-lanes = <1>;
   channel-id = <1>;
   status = "disabled";
  };

