 extal_clk: extal {
  compatible = "fixed-clock";
  #clock-cells = <0>;

  clock-frequency = <0>;
 };

 extalr_clk: extalr {
  compatible = "fixed-clock";
  #clock-cells = <0>;

  clock-frequency = <0>;
 };

 firmware {
  scmi {
   compatible = "arm,scmi";
   mbox-names = "tx","rx";
   mboxes = <&mailbox 0 &mailbox 1>;
   shmem = <&cpu_scp_lpri0 &cpu_scp_hpri0>;
   #address-cells = <1>;
   #size-cells = <0>;

   atomic-threshold-us = <0xffffffff>;

   scmi_devpd: protocol@11 {
    reg = <0x11>;
    #power-domain-cells = <1>;
   };

   scmi_sys: protocol@12 {
    reg = <0x12>;
   };

   scmi_clk: protocol@14 {
    reg = <0x14>;
    #clock-cells = <1>;
   };

   scmi_reset: protocol@16 {
    reg = <0x16>;
    #reset-cells = <1>;
   };
  };

  optee {
   compatible = "linaro,optee-tz";
   method = "smc";
  };
 };

 pmu_a720 {
  compatible = "arm,cortex-a720-pmu";
  interrupts-extended = <&gic 1 7 8>;
 };

 psci {
  compatible = "arm,psci-1.0", "arm,psci-0.2";
  method = "smc";
 };

 dummy_clk_sgasyncd4: dummy_clk_sgasyncd4 {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <266660000>;
 };

 dummy_clk_wdt: dummy_clk_wdt {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <32800>;
  clock-output-names = "watchdog";
 };

 rsw3_clk: rsw3_clk {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 dummy_clk_wcrc: dummy_clk_wcrc {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 scif_clk: scif {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <0>;
 };

 pcie4_bus_clk: pcie4_bus {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <100000000>;
 };

 pcie6_bus_clk: pcie6_bus {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <100000000>;
 };

 rpc_ref_clk: rpc_ref_clk {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <160000000>;
  clock-output-names = "rpc";
 };

 dummy_clk_sgasyncd16: dummy_clk_sgasyncd16 {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <66666666>;
 };

 dummy_clk_s0asyncd8: dummy_clk_s0asyncd8 {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <100000000>;
 };

 dummy_tcki: dummy_tcki {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <240000>;
  clock-output-names = "rtcatcki";
 };

 vcon_dclk: vcon_dclk {
  compatible = "fixed-clock";
  clock-frequency = <550000000>;
  #clock-cells = <0>;
 };

 soc: soc {
  compatible = "simple-bus";
  interrupt-parent = <&gic>;
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  mfis: mfis@18800000 {
   compatible = "renesas,mfis";
   reg = <0x0 0x18800000 0x0 0x1000>,
         <0x0 0x18801000 0x0 0x1000>,
         <0x0 0x18802000 0x0 0x1000>,
         <0x0 0x18803000 0x0 0x1000>,
         <0x0 0x18804000 0x0 0x1000>,
         <0x0 0x18805000 0x0 0x1000>,
         <0x0 0x18806000 0x0 0x1000>,
         <0x0 0x18807000 0x0 0x1000>,
         <0x0 0x189e0900 0x0 0x4>;
   reg-names = "ch0", "ch1", "ch2", "ch3",
        "ch4", "ch5", "ch6", "ch7",
         "unlock_reg";
   interrupts = <0 101 4>,
         <0 103 4>,
         <0 105 4>,
         <0 107 4>,
         <0 109 4>,
         <0 111 4>,
         <0 113 4>,
         <0 115 4>;
   interrupt-names = "ch0", "ch1", "ch2", "ch3",
       "ch4", "ch5", "ch6", "ch7";
   renesas,mfis-channels = <0 1 2>;
   status = "disabled";
  };

  mailbox: mfis_mbox@18842000 {
   compatible = "renesas,mfis-mbox";
   #mbox-cells = <1>;
   reg = <0x0 0x18842004 0x0 0x4>,
         <0x0 0x18842000 0x0 0x4>;
   interrupts = <0 4362 4>;
   status = "disabled";
  };

  mfis_lock@189e0000 {
   compatible = "renesas,mfis-lock-r8a78000",
         "renesas,mfis-lock-gen5";
   reg = <0 0x189e0000 0 0x900>, <0x0 0x189e0900 0x0 0x4>;
   reg-names = "io_base", "unlock_reg";
   #hwlock-cells = <1>;
  };

  prr: chipid@189e0044 {
   compatible = "renesas,prr";
   reg = <0 0x189e0044 0 4>;
  };

  gic: interrupt-controller@39000000 {
   compatible = "arm,gic-v3";
   #interrupt-cells = <3>;
   #address-cells = <0>;
   interrupt-controller;
   redistributor-stride = <0x0 0x40000>;

   #redistributor-regions = <32>;
   reg = <0x0 0x39000000 0x0 0x20000>,
         <0x0 0x39080000 0x0 0x40000>,
         <0x0 0x390C0000 0x0 0x40000>,
         <0x0 0x39100000 0x0 0x40000>,
         <0x0 0x39140000 0x0 0x40000>,
         <0x0 0x39180000 0x0 0x40000>,
         <0x0 0x391C0000 0x0 0x40000>,
         <0x0 0x39200000 0x0 0x40000>,
         <0x0 0x39240000 0x0 0x40000>,
         <0x0 0x39280000 0x0 0x40000>,
         <0x0 0x392C0000 0x0 0x40000>,
         <0x0 0x39300000 0x0 0x40000>,
         <0x0 0x39340000 0x0 0x40000>,
         <0x0 0x39380000 0x0 0x40000>,
         <0x0 0x393C0000 0x0 0x40000>,
         <0x0 0x39400000 0x0 0x40000>,
         <0x0 0x39440000 0x0 0x40000>,
         <0x0 0x39480000 0x0 0x40000>,
         <0x0 0x394C0000 0x0 0x40000>,
         <0x0 0x39500000 0x0 0x40000>,
         <0x0 0x39540000 0x0 0x40000>,
         <0x0 0x39580000 0x0 0x40000>,
         <0x0 0x395C0000 0x0 0x40000>,
         <0x0 0x39600000 0x0 0x40000>,
         <0x0 0x39640000 0x0 0x40000>,
         <0x0 0x39680000 0x0 0x40000>,
         <0x0 0x396C0000 0x0 0x40000>,
         <0x0 0x39700000 0x0 0x40000>,
         <0x0 0x39740000 0x0 0x40000>,
         <0x0 0x39780000 0x0 0x40000>,
         <0x0 0x397C0000 0x0 0x40000>,
         <0x0 0x39800000 0x0 0x40000>,
         <0x0 0x39840000 0x0 0x40000>;

   interrupts = <1 9 4>;
  };

  pfc: pinctrl@c0400000 {
   compatible = "renesas,pfc-r8a78000";
   reg = <0 0xc1080000 0 0x104>, <0 0xc1080800 0 0x104>,
         <0 0xc1081000 0 0x104>, <0 0xc0800000 0 0x104>,
         <0 0xc0800800 0 0x104>, <0 0xc0400000 0 0x104>,
         <0 0xc0400800 0 0x104>, <0 0xc0401000 0 0x104>,
         <0 0xc0401800 0 0x104>, <0 0xc9b00000 0 0x104>,
         <0 0xc9b00800 0 0x104>;
  };

  cmt0: timer@c64c0000 {
