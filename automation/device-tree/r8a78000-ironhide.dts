};

&rcar_sound {
 pinctrl-0 = <&sound_clk_pins>, <&sound_pins>;
 pinctrl-names = "default";

 #sound-dai-cells = <0>;

 #clock-cells = <0>;

 clock-frequency = <12288000>;

 status = "okay";

 rcar_sound,dai {
  dai0 {
   playback = <&ssi5>;
   capture = <&ssi5>;
  };
 };
};

&rsw3_clk {
 clock-frequency = <66660000>;
};

&rswitch3 {
 status = "okay";
 pinctrl-0 = <&eth25g2_pins>, <&ethes0_pins>;
 pinctrl-names = "default";

 ethernet-ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@4 {
   reg = <4>;
   renesas,etha-mii-chan = <4>;
   phy-handle = <&q32xx_phy>;
   phy-mode = "usxgmii";
   phys = <&eth_pcs 4>;
   max-speed = <10000>;

   mdio {
    #address-cells = <1>;
    #size-cells = <0>;
    q32xx_phy: ethernet-phy@1 {
     reg = <1>;
     compatible = "ethernet-phy-ieee802.3-c45";
    };
   };
  };

  port@5 {
   reg = <5>;
   renesas,etha-mii-chan = <4>;
   renesas,connect_to_xpcs;
   phy-handle = <&dp83869_phy>;
   phy-mode = "sgmii";
   phys = <&eth_pcs 5>;

   mdio {
    #address-cells = <1>;
    #size-cells = <0>;
    dp83869_phy: ethernet-phy@2 {
     reg = <2>;
     ti,sgmii-interface;
     ti,max-output-impedance;
     ti,refclk-output-enable;
     ti,clk-output-sel = <0xc>;
    };
   };
  };
 };
};

&usb30 {
 status = "okay";
