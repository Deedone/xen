  gsx: gsx@cb000000 {
   compatible = "renesas,gsx";
   reg = <0 0xcb000000 0 0x200000>;
   interrupts = <0 482 4>;
   clocks = <&scmi_clk 554>,
     <&scmi_clk 555>,
     <&scmi_clk 556>,
