 status = "okay";
 clock-frequency = <400000>;

 io_expander_u297: gpio@77 {
  compatible = "ti,tca9539";
        reg = <0x77>;
        gpio-controller;
        #gpio-cells = <2>;
        interrupt-controller;
        #interrupt-cells = <2>;

        interrupt-parent = <&gpio4>;
        interrupts = <4 2>;
 };

    max20087_0: regulator@28 {
        compatible = "maxim,max20087";
        reg = <0x28>;
    };

    max20087_1: regulator@29 {
        compatible = "maxim,max20087";
        reg = <0x29>;
    };
};

&i2c2 {
 pinctrl-0 = <&i2c2_pins>;
 pinctrl-names = "default";
 clock-frequency = <400000>;

 status = "okay";

 io_expander_u299: gpio@77 {
  compatible = "ti,tca9539";
        reg = <0x77>;
        gpio-controller;
        #gpio-cells = <2>;
        interrupt-controller;
        #interrupt-cells = <2>;

        interrupt-parent = <&gpio4>;
        interrupts = <4 2>;
 };

    max20087_2: regulator@2a {
        compatible = "maxim,max20087";
        reg = <0x2a>;
    };

    max20087_3: regulator@2b {
        compatible = "maxim,max20087";
